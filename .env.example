# Copy to .env and adjust as needed.
# Compose and the API already use these same values as defaults,
# so a .env file is optional for local demo use.
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
POSTGRES_DB=inventory_service
POSTGRES_PORT=5433

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/inventory_service
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=password123
